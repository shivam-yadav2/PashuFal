# ==============================================================================
# Purvanchal Dairy & Pashu Kendra — Environment Configuration (.env)
# ==============================================================================

# Server Runtime
PORT=3000
NODE_ENV=development

# ----------------- LOCAL MYSQL DATABASE CONFIGURATION -----------------
# Set these variables to connect to your local MySQL server.
# If omitted or offline, the app gracefully falls back to the in-memory mock store.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=purvanchal_dairy

# ----------------- BUSINESS & NOTIFICATIONS -----------------
# WhatsApp Notification Number (without + or spaces, e.g. 919792820684)
VITE_WHATSAPP_NUMBER=919792820684
VITE_CONTACT_PHONE=+919792820684
VITE_FARM_LOCATION="Khardaha Nilkanth, Lar, Deoria, Uttar Pradesh"

# ----------------- SECURITY & AUTH -----------------
JWT_SECRET=super_secret_purvanchal_dairy_key_change_in_production
SESSION_EXPIRES_IN=7d

# ----------------- AI STUDIO / CLOUD RUN (Optional) -----------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
