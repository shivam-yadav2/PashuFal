# ==============================================================================
# Purvanchal Dairy & Pashu Kendra — Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env for local development. In production (cPanel or
# anywhere else), prefer setting these as real environment variables — see
# DEPLOYMENT.md — rather than uploading a .env file to a web-accessible folder.

# Server Runtime
PORT=3000
# development locally; production on a real server (enables security headers'
# strictest settings, secure cookies, and disables the Vite dev middleware).
NODE_ENV=development

# ----------------- MYSQL DATABASE -----------------
# On shared hosting (cPanel), create the database and a dedicated DB user via
# cPanel's "MySQL Databases" tool — do not use the MySQL root account.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=your_db_name

# Separate database for the integration test suite (`npm test`), local dev
# only. Create it once and load database/schema.sql into it; tests truncate
# its tables between runs, so never point this at your real data.
MYSQL_TEST_DATABASE=purvanchal_dairy_test

# ----------------- BUSINESS & NOTIFICATIONS -----------------
# WhatsApp Notification Number (without + or spaces, e.g. 919792820684)
VITE_WHATSAPP_NUMBER=919792820684
VITE_CONTACT_PHONE=+919792820684
VITE_FARM_LOCATION="Khardaha Nilkanth, Lar, Deoria, Uttar Pradesh"

# ----------------- ADMIN LOGIN SESSIONS -----------------
# A long random string that signs admin login sessions. Anyone who has this
# value can forge a valid admin session, so treat it like a password and
# generate a fresh one for production — never reuse the example below.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_string_before_deploying
SESSION_EXPIRES_IN=7d
